# Bu faylni .env nomi bilan nusxalang va haqiqiy qiymatlarni kiriting.
# .env fayli HECH QACHON GitHub'ga yuklanmasin (.gitignore'da bor).

# === TELEGRAM BOT ===
BOT_TOKEN=

# === TELEGRAM KANAL (majburiy obuna uchun) ===
CHANNEL_ID=
CHANNEL_USERNAME=

# === SUPABASE ===
SUPABASE_URL=
SUPABASE_KEY=

# === ADMIN PANEL ===
ADMIN_USERNAME=
ADMIN_PASSWORD=
# JWT_SECRET: kamida 32 ta belgidan iborat, tasodifiy qator bo'lsin.
# Generatsiya qilish uchun: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# === SERVER ===
PORT=3000
NODE_ENV=development
# Admin panel qaysi manzildan (origin) so'rov yubora olishini cheklaydi.
ALLOWED_ORIGIN=http://localhost:3000
